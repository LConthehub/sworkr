# Copy this file to ".env" (same folder) and fill it in, then restart sworkr.
# .env is never committed to git.

# --- Email account for safety check-in alerts ---
# sworkr sends the alert email through this account. Use an app password, not your normal password.
# Gmail:   SMTP_HOST=smtp.gmail.com        SMTP_PORT=587   (app password: Google Account > Security > App passwords)
# Outlook: SMTP_HOST=smtp-mail.outlook.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The "from" address. Leave empty to use SMTP_USER.
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls

# Passkeys work on whatever address you open sworkr at (https, or localhost on this computer). To allow only
# certain addresses, list them here, comma separated, exactly as the browser shows them:
# PASSKEY_ORIGINS=https://sworkr.example.com,http://localhost:8080
